# Copy to .env and edit. Never commit real secrets.
APP_ENV=development            # development | production (production refuses the default SECRET_KEY)
SECRET_KEY=change-me           # JWT signing + IP-hash salt.   generate: openssl rand -hex 32
MASTER_KEY=change-me-too       # encrypts stored LLM API keys. generate: openssl rand -hex 32
ADMIN_PASSWORD=admin123        # seeded demo accounts (change for any shared deployment)
ANALYST_PASSWORD=analyst123
VIEWER_PASSWORD=viewer123
HOST=0.0.0.0
PORT=8000
KAFKA_BOOTSTRAP=               # empty = in-memory bus. e.g. localhost:9092 (needs: pip install kafka-python)
DATABASE_PATH=data/aegis.db
MODELS_DIR=models
AUTH_ENABLED=true
AGENT_ENABLED=false            # optional LLM agent
LLM_PROVIDER=disabled          # disabled | grok | openai | claude | ollama
LLM_MODEL=
LLM_API_KEY=                   # env-only alternative to saving the key via the Settings page
